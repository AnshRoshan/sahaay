# --- required ---
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/app_db

# --- security (set before deploying publicly) ---
SAHAAY_ACCESS_CODE=
SESSION_SECRET=
CRON_SECRET=

# --- open-source reasoning (Gemma via any OpenAI-compatible server, e.g. Ollama) ---
GEMMA_BASE_URL=
GEMMA_MODEL=gemma3:4b
GEMMA_API_KEY=

# --- TabPFN forecasting service (services/tabpfn) ---
TABPFN_URL=
TABPFN_API_KEY=

# --- external research / voice / observability / workflows (all optional) ---
SERPAPI_KEY=
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
SENTRY_DSN=
TEMPORAL_ADDRESS=
